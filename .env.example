EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Demo default: skip forced login. Use `true` after migration 003 + real SMS/session.
EXPO_PUBLIC_REQUIRE_AUTH=false

# Edge Function authoritative scoring — deploy `finalize-assessment` then keep true.
EXPO_PUBLIC_PREFER_EDGE_FINALIZE=true

# Never enable in prod after migration 003 (RLS removes client INSERT on results).
# Prottoy field path must keep this false — no client score snapshots.
EXPO_PUBLIC_ALLOW_CLIENT_RESULT_SNAPSHOT=false

# PROTTOY path: category + consent + 40+5 + completion hand-back (no field scores).
# Requires migration 004, Edge assemble-form/select-followups/finalize-assessment, and item bank import.
EXPO_PUBLIC_PROTTOY_BANK=false

# Do not put branch-manager or Antarious lab passwords in EXPO_PUBLIC_*.
# Those accounts are Supabase Auth users. The app only sends the password at sign-in.

# Server-side import tools only (never put service role in Expo):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PROTTOY_PACK_DIR=./prottoy-pack
