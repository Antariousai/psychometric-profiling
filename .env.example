EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Demo default: skip forced login. Use `true` after migration 003 + real SMS/session.
EXPO_PUBLIC_REQUIRE_AUTH=false

# Edge Function authoritative scoring — deploy `finalize-assessment` then keep true.
EXPO_PUBLIC_PREFER_EDGE_FINALIZE=true

# Never enable in prod after migration 003 (RLS removes client INSERT on results).
EXPO_PUBLIC_ALLOW_CLIENT_RESULT_SNAPSHOT=false

# Staging/dev only: staff user email + password created in Supabase Auth dashboard
EXPO_PUBLIC_DEV_AUTH_EMAIL=
EXPO_PUBLIC_DEV_AUTH_PASSWORD=
